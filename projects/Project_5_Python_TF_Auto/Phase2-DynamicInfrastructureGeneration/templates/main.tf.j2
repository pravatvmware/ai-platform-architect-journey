terraform {
  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0.0"
    }
  }
}

provider "docker" {}

# Dynamically fetch the base image from config
resource "docker_image" "app_image" {
  name         = "{{ base_image }}"
  keep_locally = false
}

{% for container in containers %}
# Generated Container: {{ container.name }}
resource "docker_container" "{{ container.name }}" {
  image = docker_image.app_image.image_id
  name  = "{{ container.name }}"
  
  ports {
    internal = {{ container.internal_port }}
    external = {{ container.external_port }}
  }
}
{% endfor %}